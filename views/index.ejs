
    
<%- include('./partials/header') %>

<h1>Display the blog</h1>
<a href="/blog/new">New</a>
<article>
    <% for(let blog of allblog){ %>
        <div>
            <h1><%=blog.id%></h1>
            <h2><%=blog.title%></h2>
            <h3><%=blog.author%></h3>
            <p><%=blog.comment%></p>
            <p><a href="/blog/<%=blog.id%>">show</a></p>
        </div>
        <% } %>
</article>


<%- include('/partials/footer') %>